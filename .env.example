# ══════════════════════════════════════════════════════════════════
#  AImageGen — environment.  Copy to `.env.local` (dev) or `.env` (prod).
#  NEVER commit the filled-in file — .gitignore already excludes it.
# ══════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────
# Local MongoDB on the same VPS (recommended — see DEPLOY.md):
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=aimagegen

# ── AI key ────────────────────────────────────────────────────────
# Leave BLANK to run in DEMO mode (placeholder images, no key needed, full
# click-through of every flow). Paste a real key to switch to live Gemini.
GEMINI_API_KEY=

# ── Image engines ─────────────────────────────────────────────────
# BASE  = every normal generation (extra poses, edits, imagined-model heroes)
# HERO  = the saved-model hero shot only, where identity is decided
BASE_MODEL_ID=gemini-3.1-flash-lite-image
HERO_MODEL_ID=gemini-3.1-flash-image

# Print every outgoing image prompt to the server console.
# Defaults to on in dev, off in production. Set to 1 to force it on anywhere.
LOG_PROMPTS=1

# ── Razorpay (credit top-ups) ─────────────────────────────────────
# Dashboard → Settings → API Keys. Use rzp_test_ keys until the flow is proven.
# Checkout is disabled and the Recharge page says so when these are unset.
#
# NEVER put real values in this file — it is committed to git. Real keys belong
# in .env.local (gitignored) or in your host's environment-variable settings.
RAZORPAY_KEY_ID=
# Server-only. Shown once at generation — never expose to the browser.
RAZORPAY_KEY_SECRET=
# You choose this string when creating the webhook in the Razorpay dashboard.
# Point the webhook at https://<your-domain>/api/razorpay/webhook and subscribe
# to payment.captured and payment.failed.
RAZORPAY_WEBHOOK_SECRET=
# Shown on the Razorpay Checkout modal.
PAYMENT_BRAND=Vdofy Studio
PAYMENT_CURRENCY=INR

# ── Invoicing (printed on every tax invoice) ──────────────────────
# A tax invoice must legally carry your registered name, address and GSTIN.
# Leave SELLER_GSTIN blank if you are not GST-registered — the invoice then
# omits all tax lines and says "GST not charged" instead of inventing a split.
SELLER_NAME=Vdofy Studio
SELLER_ADDRESS=
SELLER_GSTIN=
SELLER_PAN=
SELLER_EMAIL=
# Your state, e.g. "Maharashtra". Decides CGST+SGST (same state) vs IGST.
SELLER_STATE=
# SAC code for the service sold. 998314 = IT design & development services.
INVOICE_SAC=998314
# Invoice numbers come out as <prefix>/2026-27/0001, restarting each April.
INVOICE_PREFIX=INV

# ── Admin account (seeded on first boot if no admin exists) ───────
ADMIN_EMAIL=admin@vdofy.app
ADMIN_PASSWORD=change-me-before-deploying

# ── Wallet ────────────────────────────────────────────────────────
# Credits a brand-new account starts with.
DEFAULT_BALANCE_IMAGES=100

# ── Storage ───────────────────────────────────────────────────────
# Where generated images live. "local" = plain files on this server's disk.
# The storage layer is an adapter (src/lib/storage.ts) so this is the only
# thing that changes if you later move to S3 / Cloudflare R2.
STORAGE_DRIVER=local
# Absolute path preferred in production, e.g. /var/lib/aimagegen/data
DATA_DIR=./data

# ── Our own Google spend (for the Logs tab "Cost (USD)" column) ───
# USD per 1,000,000 tokens, per model. This is what WE pay Google — it is not
# what the user is charged (that's the admin credits grid). Optional override:
# TOKEN_RATES_USD={"gemini-3.1-flash-image":{"in":0.30,"out":30.0}}
TOKEN_RATES_USD=

# ── Server ────────────────────────────────────────────────────────
PORT=8080